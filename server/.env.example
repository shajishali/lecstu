# ══════════════════════════════════════
# LECSTU Server Environment Variables
# ══════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# JWT Secrets (CHANGE THESE IN PRODUCTION)
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Timetable PDF extraction (pdfplumber — position + text layout). Run: npm run timetable-extract
# TIMETABLE_EXTRACT_URL=http://localhost:8002

# ASR Service (Phase 7.1) - for Tamil/Sinhala voice (and English when Web Speech unavailable)
# Default: server spawns Python subprocess per request (slower, no extra process).
# For faster voice: run "npm run asr" in a separate terminal, then uncomment below:
# ASR_USE_HTTP=true
# ASR_SERVICE_URL=http://localhost:8001
# PYTHON_PATH=python   # or path to venv: ai-services/asr/venv/Scripts/python.exe

# Azure Speech (optional - for ASR engine "azure")
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=eastus

# Chatbot API (Phase 8.2) - used by Rasa actions to call platform API
# Must match CHATBOT_API_KEY in ai-services/chatbot when running actions
CHATBOT_API_KEY=lecstu-chatbot-dev-key

# Floor plan AI (OCR rooms + auto navigation) — npm run floorplan-vision (port 8003)
FLOORPLAN_VISION_URL=http://localhost:8003
FLOORPLAN_VISION_ENABLED=true

# Indoor Navigation AI Engine — npm run indoor-navigation (port 8004)
INDOOR_NAVIGATION_URL=http://localhost:8004
INDOOR_NAVIGATION_ENABLED=true
# Optional: NAV_USE_YOLO=true, NAV_USE_LLM=true (Ollama at localhost:11434)

# Translation (Phase 9.1) - Python path for run_translate.py
# PYTHON_PATH=python   # or path to venv

# Google Cloud Translation (optional - for engine "google")
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Azure Translator (optional - for engine "azure")
# AZURE_TRANSLATOR_KEY=your-key
# AZURE_TRANSLATOR_REGION=eastus

# Email — password reset & registration verification codes (Phase 12)
# Recipients can use any provider (Gmail, Outlook, @kln.ac.lk, etc.)
#
# Development — Gmail app password (https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lecstu.system@gmail.com
SMTP_PASS=your-gmail-app-password-here
MAIL_FROM="LECSTU <lecstu.system@gmail.com>"
# true = log emails to server console instead of SMTP (local dev without credentials)
SMTP_DISABLED=true
#
# University inboxes (@stu.kln.ac.lk, @kln.ac.lk) — use Office 365 sender for reliable delivery.
# Gmail often reaches the SMTP server but Microsoft 365 quarantines it before the inbox.
# UNIVERSITY_EMAIL_DOMAINS=stu.kln.ac.lk,kln.ac.lk
# SMTP_UNIVERSITY_HOST=smtp.office365.com
# SMTP_UNIVERSITY_PORT=587
# SMTP_UNIVERSITY_SECURE=false
# SMTP_UNIVERSITY_USER=noreply@kln.ac.lk
# SMTP_UNIVERSITY_PASS=your-office365-app-password
# SMTP_UNIVERSITY_MAIL_FROM="LECSTU <noreply@kln.ac.lk>"
#
# Production — single university sender (coordinate with IT for @kln.ac.lk mailbox):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@kln.ac.lk
# SMTP_PASS=your-office365-app-password
# MAIL_FROM="LECSTU <noreply@kln.ac.lk>"
# SMTP_DISABLED=false
#
# Scale (future) — swap transport in emailService.ts; env shape stays similar:
# SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_USER=apikey SMTP_PASS=<api-key>
# Resend: use their SMTP relay or REST API behind the same service interface
#
# Testing: npm run test:phase-12-6  |  docs/email-verification/PHASE-12-6-TEST-MATRIX.md
